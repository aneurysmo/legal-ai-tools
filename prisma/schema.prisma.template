// PLANTILLA — no editar directamente para cambiar de proveedor de base de
// datos. El marcador de proveedor (dos guiones bajos + DB_PROVIDER + dos
// guiones bajos) que aparece abajo en el bloque 'datasource' se reemplaza
// automaticamente por scripts/prepare_prisma_schema.py segun la variable de
// entorno DB_PROVIDER (definida en tu .env / .env.demo / .env.prod). El
// archivo real que usan los comandos de Prisma es prisma/schema.prisma
// (generado, ignorado por git) — ver README.md > "Base de datos (Prisma)".

datasource db {
  provider = "__DB_PROVIDER__"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "sync"
  recursive_type_depth = 5
}

model User {
  id                  Int      @id @default(autoincrement())
  username            String   @unique
  email               String   @unique
  firstName           String?
  lastName            String?
  avatar              String   @default("default-generic")
  passwordHash        String
  securityQuestion    String
  securityAnswerHash  String
  createdAt           DateTime @default(now())

  documents    Document[]
  messages     ChatMessage[]
  activityLogs ActivityLog[]
}

model Document {
  id           Int      @id @default(autoincrement())
  filename     String
  sizeBytes    Int
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById Int
  uploadedAt   DateTime @default(now())
  documentType String?
  summary      String?

  chunks Chunk[]

  @@unique([filename, sizeBytes])
}

model Chunk {
  id         Int      @id @default(autoincrement())
  document   Document @relation(fields: [documentId], references: [id])
  documentId Int
  ordinal    Int
  text       String
  embedding  String

  @@index([documentId])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  tool      String
  filename  String
  createdAt DateTime @default(now())
}
