# Plantilla para el ambiente DEMO (ej. Cloud Run con scale-to-zero, o
# Streamlit Community Cloud). Copiar los valores reales a las variables de
# entorno del servicio de despliegue — no subir un archivo .env real al
# repositorio ni a la imagen de Docker.
#
# Uso local para probar este ambiente antes de desplegar:
#   copy .env.demo.example .env.demo   (Windows)
#   python scripts/prepare_prisma_schema.py   (con DB_PROVIDER cargado desde .env.demo)

LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR.DEMO.KEY
GROQ_API_KEY=YOUR.DEMO.KEY
LLM_FALLBACK_PROVIDER=groq

# Postgres gestionado, tier gratuito (ej. Neon free / Supabase free).
# Nunca apuntar el ambiente demo a la base de datos de produccion.
DB_PROVIDER=postgresql
DATABASE_URL=postgresql://user:password@YOUR-DEMO-HOST/dbname?sslmode=require
