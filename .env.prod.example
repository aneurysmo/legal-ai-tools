# Plantilla para el ambiente de PRODUCCION (cliente que ya contrato). Copiar
# los valores reales a un secret manager (Google Secret Manager, AWS
# Secrets Manager, etc.) o a las variables de entorno del servicio de
# despliegue — NUNCA subir un archivo .env real al repositorio ni a la
# imagen de Docker.
#
# La base de datos de produccion debe ser un proyecto/instancia Postgres
# SEPARADO del usado en demo (nunca compartir instancia). Recomendado
# activar backups automaticos y, si el volumen de documentos crece,
# considerar la extension pgvector para busqueda semantica escalable.

LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR.PROD.KEY
GROQ_API_KEY=YOUR.PROD.KEY
LLM_FALLBACK_PROVIDER=groq

DB_PROVIDER=postgresql
DATABASE_URL=postgresql://user:password@YOUR-PROD-HOST/dbname?sslmode=require
